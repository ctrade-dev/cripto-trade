# Modelo do .env da VPS (T63). Copie para .env ao lado deste arquivo, preencha e deixe com permissao 600:
#   cp .env.example .env && chmod 600 .env
# Somente chaves da TESTNET. Nada de producao entra neste ambiente.

# Binance testnet (https://testnet.binance.vision)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Chave da API admin (header X-Admin-Key). Gere uma propria da VPS: uuidgen
ADMIN_API_KEY=

# Senhas locais da VPS. Gere com: openssl rand -hex 24
DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Opcionais: alertas no Discord e link "ver logs" do embed
DISCORD_WEBHOOK_URL=
GRAFANA_EXPLORE_URL_TEMPLATE=

# Checkout do ctrade-dev/ctrade-strategies numa versao fixa (caminho absoluto)
STRATEGIES_DIR=/home/ubuntu/ctrade-strategies

# Token de cada app de estrategia; o mesmo valor vai no cadastro (register-strategies.sh).
# Gere com: openssl rand -hex 24
TREND_TOKEN=
REVERSION_TOKEN=
BOOK_TOKEN=
BREAKOUT_TOKEN=
CHAOS_TOKEN=

# Caos segura o lote aberto (exercita OVERSELL contra o lote, T61). Padrao das rodadas da T53.
CHAOS_HOLD_POSITION=true
