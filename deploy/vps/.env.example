# Modelo do .env da VPS (T63, T74). Copie para .env ao lado deste arquivo, preencha e deixe com permissao 600:
#   cp .env.example .env && chmod 600 .env
# Somente chaves da TESTNET. Nada de producao entra neste ambiente.

# --- Staging (T74): ctrade-app, conta da testnet propria do staging ---
# Chave criada pelo mantenedor no login da conta do staging (https://testnet.binance.vision), sem saque.
BINANCE_API_KEY_STG=
BINANCE_API_SECRET_STG=
# Chave da API admin do staging (header X-Admin-Key): uuidgen
ADMIN_API_KEY_STG=
# Senha do usuario ctrade_stg do Postgres (schema staging): openssl rand -hex 24 (so letras e numeros)
DB_PASSWORD_STG=
# Webhook do canal #ctrade-staging. Obrigatorio: o perfil prod nao sobe sem ele; os alertas do Grafana vao para ele.
DISCORD_WEBHOOK_URL_STG=

# --- Soak (T63): ctrade-soak e apps de soak, conta da testnet do soak ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Chave da API admin do soak: uuidgen
ADMIN_API_KEY=
# Senha do usuario ctrade_soak do Postgres (schema soak): openssl rand -hex 24 (so letras e numeros)
DB_PASSWORD_SOAK=
# Opcional: avisos dos scripts de rodada e do ctrade-soak
DISCORD_WEBHOOK_URL=

# --- Compartilhado ---
# Senha do usuario administrador do Postgres (ctrade) e do Grafana: openssl rand -hex 24
DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# Opcional: link "ver logs" do embed do Discord
GRAFANA_EXPLORE_URL_TEMPLATE=

# Checkout do ctrade-dev/ctrade-strategies numa versao fixa (caminho absoluto)
STRATEGIES_DIR=/home/ubuntu/ctrade-strategies

# Token de cada app de soak; o mesmo valor vai no cadastro (register-strategies.sh).
# Gere com: openssl rand -hex 24
TREND_TOKEN=
REVERSION_TOKEN=
BOOK_TOKEN=
BREAKOUT_TOKEN=
CHAOS_TOKEN=

# Caos segura o lote aberto (exercita OVERSELL contra o lote, T61). Padrao das rodadas da T53.
CHAOS_HOLD_POSITION=true
